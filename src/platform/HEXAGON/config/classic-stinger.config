# 

# diff all

# version
# Betaflight / HEXAGONV66 (HEXAGON) 4.6.0 Jun 24 2025 / 17:41:26 (norevision) MSP API: 1.47

# start the command batch
batch start

# reset configuration to default settings
defaults nosave

mcu_id 000000000000000100000002
signature 

# feature
feature -GPS
feature OSD

# serial
serial UART7 128 1000000 57600 0 2470000

# aux
aux 0 0 0 1850 2050 0 0
aux 1 1 1 1400 1600 0 0
aux 2 3 1 1900 2100 0 0

# master
set acc_calibration = -68,3,-39,1
set blackbox_sample_rate = 1/1
set blackbox_device = SERIAL
set motor_idle = 300
set motor_pwm_inversion = ON
set motor_output_reordering = 1,0,2,3,4,5,6,7
set align_board_pitch = 180
set current_meter = ESC
set battery_meter = ESC
set osd_vbat_pos = 18816
set debug_mode = ALTITUDE
set ap_hover_throttle = 1350

profile 0

profile 1

profile 2

profile 3

# restore original profile selection
profile 0

rateprofile 0

rateprofile 1

rateprofile 2

rateprofile 3

# restore original rateprofile selection
rateprofile 0

# save configuration
save
# 